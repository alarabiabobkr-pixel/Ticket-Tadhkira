<script>(function(){
var hitUrl='https://akw.cam/stats/hit',pingUrl='https://akw.cam/stats/online-ping';
function cid(){try{var k='akwam_stats_id',v=localStorage.getItem(k);if(!v){v=(window.crypto&&window.crypto.randomUUID)?window.crypto.randomUUID().replace(/-/g,''):String(Date.now())+Math.random().toString(16).slice(2);localStorage.setItem(k,v)}return v}catch(e){return String(Date.now())+Math.random().toString(16).slice(2)}}
var clientId=cid(),postId=document.documentElement.getAttribute('data-stats-post-id')||'0',pageType='page';
function body(action){var d=new URLSearchParams();d.set('client_id',clientId);d.set('action',action);d.set('url',location.href);d.set('title',document.title||'');d.set('post_id',postId);d.set('page_type',pageType);d.set('user_agent',navigator.userAgent);d.set('referrer',document.referrer||'');return d.toString()}
function send(url,data){try{if(navigator.sendBeacon){var b=new Blob([data],{type:'application/x-www-form-urlencoded;charset=UTF-8'});if(navigator.sendBeacon(url,b))return}}catch(e){}try{fetch(url,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8'},body:data,keepalive:true,cache:'no-store'}).catch(function(){});}catch(e){}}
function start(){send(hitUrl,body('hit'));send(pingUrl,body('online-ping'));}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();
setInterval(function(){send(pingUrl,body('online-ping'));},30000);
})();</script>
